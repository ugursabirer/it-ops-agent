# Bu dosyayi .env olarak kopyalayin. .env dosyasi asla commit edilmez.

# --- LLM (Ollama, lokal) ---
# Model lokalde calisir; harici bir API anahtari gerekmez.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434

# LLM sicakligi. Operasyonel kararlarda determinizm icin 0 onerilir.
LLM_TEMPERATURE=0

# Tek bir cevapta uretilecek azami token. Kucuk modellerin kacak
# uretime girmesini engeller.
LLM_MAX_OUTPUT_TOKENS=1024

# --- MCP ---
# true  : operasyonel tool'lar custom FastMCP server uzerinden (stdio) kullanilir.
# false : MCP atlanir, tool'lar dogrudan SQLite'a baglanir (yedek yol).
IT_OPS_USE_MCP=true

# --- Veri yollari ---
IT_OPS_DB_PATH=ops_mcp/it_ops.db
IT_OPS_VECTOR_PATH=vector_db
IT_OPS_POLICY_PATH=data/policies

# --- Davranis ---
# Yazma aksiyonlari (talep acma) icin kullanici onayi istenir.
IT_OPS_REQUIRE_APPROVAL=true
# Agent adimlarini terminalde goster.
IT_OPS_VERBOSE=true
